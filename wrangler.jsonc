{
  "$schema": "node_modules/wrangler/config-schema.json",
  // AI assistant: set GEMINI_API_KEY in Cloudflare Pages > Settings > Environment variables
  // For local dev: create .dev.vars (git-ignored) with: GEMINI_API_KEY=your_key_here
  "name": "portfolio-game",
  "compatibility_date": "2026-05-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
  "not_found_handling": "single-page-application"
  },
  "compatibility_flags": ["nodejs_compat"],
  // To enable visitor counter: run `npx wrangler kv namespace create VISITS`
  // then replace YOUR_KV_NAMESPACE_ID below with the id from that command
  "kv_namespaces": [
    { "binding": "VISITS", "id": "YOUR_KV_NAMESPACE_ID" }
  ]
}
